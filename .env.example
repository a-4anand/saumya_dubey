# Site URL used for absolute links, sitemap and Open Graph metadata.
SITE_URL=https://www.qorivara.com
NEXT_PUBLIC_SITE_URL=https://www.qorivara.com

# Direct contact. Defaults are baked into lib/site.ts (WhatsApp 918707094072),
# so the site works without these. Set them to override in production.
PHONE_NUMBER=+918707094072
WHATSAPP_NUMBER=918707094072
BUSINESS_EMAIL=contact@qorivara.com
CONTACT_TO_EMAIL=contact@qorivara.com
CONTACT_FROM_EMAIL=

# Optional downloadable profile / capability PDF.
PROFILE_PDF_URL=

# Optional. If set, guided intake submissions are forwarded server-side to this
# endpoint or lead webhook. Do not expose server secrets with NEXT_PUBLIC_.
FORM_DESTINATION=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional booking provider URL. If absent, the site shows the guided intake.
NEXT_PUBLIC_BOOKING_URL=

# Optional analytics id.
ANALYTICS_ID=
