# Site URL used for absolute links, sitemap and Open Graph metadata.
SITE_URL=http://localhost:3000

# Direct contact. Defaults are baked into lib/site.ts (WhatsApp 918707094072),
# so the site works without these. Set them to override in production.
PHONE_NUMBER=+918707094072
WHATSAPP_NUMBER=918707094072
BUSINESS_EMAIL=

# Optional downloadable profile / capability PDF.
PROFILE_PDF_URL=

# Optional. If set, contact-form submissions are ALSO forwarded server-side to
# this endpoint (e.g. an email/webhook service). The form already delivers every
# enquiry to WhatsApp directly, so this is a secondary backup only.
FORM_DESTINATION=

# Optional analytics id.
ANALYTICS_ID=
